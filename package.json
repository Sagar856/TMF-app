{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "android:patch": "node scripts/patch-android.mjs",
    "android:build": "npm run cap:sync && node scripts/patch-android.mjs && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/local-notifications": "6.1.0",
    "@supabase/supabase-js": "2.49.1",
    "@tailwindcss/vite": "4.0.9",
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.475.0",
    "motion": "12.4.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.1",
    "vite": "6.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@types/node": "22.13.4",
    "autoprefixer": "10.4.20",
    "esbuild": "0.25.0",
    "tailwindcss": "4.0.9",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
